node_modules/
.next/
out/
.vercel
*.log

# Build artefacts — regenerated on every build.
*.tsbuildinfo

# Real env files stay out; the example documents the required vars and must
# be committed, or a deployer has no record of NEXT_PUBLIC_COLAB_REPO etc.
.env*
!.env.example

__pycache__/

# Mirrored into public/ by scripts/sync-static.mjs from data/, notebooks/ and
# streamlit/. Vercel regenerates them in prebuild, so committing them would
# just duplicate the same bytes and let the copies drift.
/public/data/
/public/notebooks/
/public/streamlit/

# generated by scripts/prebake-charts.mjs
/public/chart-data/
