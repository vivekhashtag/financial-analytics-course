# Public GitHub repo that hosts this content package. Open-in-Colab links are
# built as:
#   https://colab.research.google.com/github/<repo>/blob/<branch>/notebooks/<file>.ipynb
# The repo must be public for Colab to read it.
NEXT_PUBLIC_COLAB_REPO=vivekhashtag/financial-analytics-course
NEXT_PUBLIC_COLAB_BRANCH=main

# Production origin, no trailing slash. Used for canonical URLs, the
# `pd.read_csv(BASE + …)` snippet on dataset pages, and as the Colab fallback
# when NEXT_PUBLIC_COLAB_REPO is unset.
NEXT_PUBLIC_SITE_URL=https://your-course-domain.example
